DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatto_appointement?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Optional. Defaults to ./storage/designs. Use a persistent mounted path in production.
DESIGN_STORAGE_DIR="./storage/designs"
# Single artist only. Registration closes automatically when the owner account exists.
# Set true to also close password and Google bootstrap before the first account.
DISABLE_SIGN_UP="false"
# Optional restriction to one artist's email. Blank lets the first account claim the workspace.
# Once an owner exists, Google must verify that owner's email. Invalid nonempty values deny access.
STUDIO_OWNER_EMAIL=""
# Optional Google login; both credentials are required, with the exact BETTER_AUTH_URL callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional password recovery. Verify a sending domain in Resend first.
RESEND_API_KEY=""
EMAIL_FROM=""
# Docker Compose only. Generate a unique hex password and use it for database backups.
# POSTGRES_PASSWORD="replace-with-a-random-hex-password"
