{
  "name": "tatto-appointement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "auth:generate": "npx auth@latest generate --config src/lib/auth.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.27",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.6.27",
    "next": "16.3.6",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.2"
  }
}
