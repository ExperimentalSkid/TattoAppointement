{
  "name": "tatto-appointement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.23.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "verify:images": "node scripts/verify-image-processing.mjs",
    "verify:money": "node scripts/verify-money.mjs",
    "verify:appointments": "node scripts/verify-appointments.mjs",
    "test:unit": "node scripts/verify-money.mjs && node scripts/verify-appointments.mjs && node scripts/verify-uploads.mjs && node scripts/verify-studio-time.mjs && node scripts/verify-email.mjs && node scripts/verify-settings.mjs && node scripts/verify-studio-access.mjs && node scripts/verify-whatsapp-reminder.mjs && node scripts/verify-record-versions.mjs && node scripts/verify-diagnostics.mjs && node scripts/verify-privacy-minimization.mjs && node scripts/verify-login-preference.mjs && node scripts/verify-client-diagnostics-consent.mjs && node scripts/verify-privacy-maintenance.mjs",
    "privacy:check": "node scripts/check-privacy-config.mjs",
    "verify:privacy-config": "node scripts/verify-privacy-config.mjs",
    "test:privacy": "playwright test tests/account-privacy.spec.ts tests/client-privacy.spec.ts tests/diagnostics-consent.spec.ts tests/problem-reports.spec.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:final": "playwright test tests/final-workflows.spec.ts",
    "test:pwa": "playwright test tests/pwa.spec.ts",
    "test:qa9": "playwright test tests/qa-pass-9.spec.ts",
    "test:integration": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "auth:generate": "npx auth@latest generate --config src/lib/auth.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.27",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.6.27",
    "next": "16.3.6",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "typescript": "^5.9.2"
  }
}
